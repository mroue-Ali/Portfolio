# Production configuration for the whole stack.
#
# Copy to the REPO ROOT as `.env` — beside docker-compose.yml, not inside
# backend/. Compose reads it for ${...} substitution and hands it to the API
# container as environment. There is no backend/.env in production.
#
#   cp deploy/env.example .env && nano .env && chmod 600 .env

# --- database --------------------------------------------------------------- #
# Generate each of these separately:  openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
DB_NAME=portfolio
DB_USER=portfolio
DB_PASS=

# Host is `db` — the compose service name, resolved on the internal network.
# Not 127.0.0.1: inside the API container that would mean the API itself.
# The password here must match DB_PASS above.
DATABASE_URL=mysql+pymysql://portfolio:CHANGEME@db:3306/portfolio
DB_ENGINE=mysql
DB_HOST=db
DB_PORT=3306

APP_NAME=portfolio

# --- secrets ---------------------------------------------------------------- #
# Generate each separately:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT_SECRET falls back to ADMIN_API_KEY if blank; give it its own value so that
# rotating one does not invalidate the other.
ADMIN_API_KEY=
JWT_SECRET=
JWT_TTL_MINUTES=720

# --- the site --------------------------------------------------------------- #
# The site and API share an origin, so no browser makes a cross-origin request
# and this list protects nothing today. Kept accurate so that moving the API to
# its own subdomain fails as a clear CORS error rather than silently passing.
CORS_ORIGINS=https://mroueali.com,https://www.mroueali.com

# Alembic owns the schema; deploy.sh runs `alembic upgrade head`.
AUTO_CREATE_TABLES=0

# First administrator, created by `python -m app.seed` on an empty users table.
# Leave the password blank and one is generated and printed exactly once. Blank
# both fields again after that.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=

# --- uploads ---------------------------------------------------------------- #
# Path INSIDE the container. The host side is MEDIA_HOST_DIR below.
MEDIA_ROOT=/data/media
# URL path, not a filesystem path. Must match the nginx location block.
MEDIA_URL=/media
# Keep in step with client_max_body_size in deploy/mroueali.com.conf.
MAX_UPLOAD_MB=8

# Host directory backing the mount. Read by compose, never by the app.
MEDIA_HOST_DIR=/home/ali/apps/portfolio-media

# --- the ask bar ------------------------------------------------------------ #
# Empty AI_PROVIDER launches with the written answers from the CMS and no
# external dependency. Fill it in whenever; the written answers stay as the
# fallback behind the model.
ASK_MODE=hybrid
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=20
AI_MAX_OUTPUT_TOKENS=700
AI_CONTEXT_CHARS=24000

# --- host identity ---------------------------------------------------------- #
# The uid/gid the api and frontend containers run as, so that files they write
# into bind-mounted directories (uploads, the frontend build) belong to you.
# These are NOT 1000 on every machine. Set them from the server with:
#   printf 'APP_UID=%s\nAPP_GID=%s\n' "$(id -u)" "$(id -g)" >> .env
APP_UID=1000
APP_GID=1000
