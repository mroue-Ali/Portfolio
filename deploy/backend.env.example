# Production backend/.env for mroueali.com.
#
# Copy to /home/ali/apps/Portfolio/backend/.env on the server, fill in the
# blanks, then:  chmod 600 backend/.env
# Never committed — backend/.gitignore already covers it.

APP_NAME=portfolio

# MySQL in a Docker container, published on the loopback only (see the runbook).
# Replace CHANGEME with the password used when creating the container.
DATABASE_URL=mysql+pymysql://portfolio:CHANGEME@127.0.0.1:3306/portfolio
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio
DB_USER=portfolio
DB_PASS=CHANGEME

# Generate each of the two below separately:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Machine access on /api/admin/* via the X-Admin-Key header.
ADMIN_API_KEY=

# Signs CMS session tokens. Set it to its own value here rather than letting it
# fall back to ADMIN_API_KEY — rotating one should not invalidate the other.
JWT_SECRET=
JWT_TTL_MINUTES=720

# The site and the API share an origin, so a browser never sends a cross-origin
# request and this list is not what protects anything. Kept accurate anyway, so
# that the day the API moves to api.mroueali.com the failure is a clear CORS
# error rather than a silent success from a stale wildcard.
CORS_ORIGINS=https://mroueali.com,https://www.mroueali.com

# Alembic owns the schema; deploy.sh runs `alembic upgrade head`.
AUTO_CREATE_TABLES=0

# First administrator. Run `python -m app.seed` once, with the users table empty.
# Leave the password blank and one is generated and printed a single time —
# copy it immediately, then blank BOOTSTRAP_USERNAME/PASSWORD out of this file.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=

# Outside the repo on purpose: uploads must survive `git pull`, and a directory
# inside the working tree is one `git clean -xdf` away from being deleted.
# This path must match ReadWritePaths= in portfolio-api.service.
MEDIA_ROOT=/home/ali/apps/portfolio-media
MEDIA_URL=/media
# Keep in step with client_max_body_size in the nginx block.
MAX_UPLOAD_MB=8

# --- the ask bar ------------------------------------------------------------ #
# Leave AI_PROVIDER empty to launch: the bar answers from the written answers in
# the CMS and nothing about it can fail. Fill it in whenever you want the model
# path, and the written answers stay as the fallback behind it.
ASK_MODE=hybrid
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=20
AI_MAX_OUTPUT_TOKENS=700
AI_CONTEXT_CHARS=24000
