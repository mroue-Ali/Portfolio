APP_NAME=portfolio

# MySQL (a container on the dev machine).
DATABASE_URL=mysql+pymysql://root:root_pass@localhost:3306/portfolio
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=portfolio
DB_USER=root
DB_PASS=root_pass

# CMS auth: sent as the X-Admin-Key header on /api/admin/* routes.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Browser origins allowed to call the API (Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Alembic owns the schema now; create_all() on startup stays off.
AUTO_CREATE_TABLES=0

# Signs CMS session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset, it falls back to ADMIN_API_KEY. Changing it signs everyone out.
JWT_SECRET=
# How long a sign-in lasts, in minutes (default 720 = 12h).
JWT_TTL_MINUTES=720

# First administrator, created by `python -m app.seed` on an empty users table.
# Leave the password blank to have one generated and printed once.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=

# --------------------------------------------------------------------------- #
# The ask bar
#
# Leave AI_PROVIDER empty and the bar keeps working exactly as it does now, off
# the answers written in the CMS. Fill it in and a model answers instead, from
# the tables it picks per question — with the written answers still catching any
# failure, so a rate limit or a dead key is never visible to a visitor.
# --------------------------------------------------------------------------- #

# hybrid = written answer on an exact question match, model otherwise (default)
# ai     = always the model
# keyword = never the model
ASK_MODE=hybrid

# groq       — fastest, generous free tier   https://console.groq.com/keys
# gemini     — largest free daily quota      https://aistudio.google.com/apikey
# openrouter — many models, use a :free one  https://openrouter.ai/keys
# ollama     — a model on this machine, no key needed
AI_PROVIDER=
AI_API_KEY=

# Optional. Empty means the provider default (see app/ai/llm.py):
#   groq -> openai/gpt-oss-120b, gemini -> gemini-2.0-flash,
#   openrouter -> meta-llama/llama-3.3-70b-instruct:free, ollama -> llama3.1
# Providers rotate their catalogues. On a `model_not_found` 404, list what your
# key can actually reach and set AI_MODEL to one of them:
#   curl -H "Authorization: Bearer $AI_API_KEY" https://api.groq.com/openai/v1/models
AI_MODEL=
AI_BASE_URL=

# Choosing which tables to read is easier than answering from them, so it runs on
# the provider's smaller model (groq -> openai/gpt-oss-20b). Set to override.
AI_ROUTER_MODEL=

# Two model calls per question, so a visitor waits for at most twice this.
AI_TIMEOUT=20
AI_MAX_OUTPUT_TOKENS=700
# Ceiling on the rows sent to the model, in characters.
AI_CONTEXT_CHARS=24000

# Uploaded images: where they are written, and how big one may be.
# The directory is created on first upload and is never committed.
MEDIA_ROOT=
MEDIA_URL=/media
MAX_UPLOAD_MB=8
