# Where the content API lives.
#
# Leave VITE_API_URL unset for local work: the app calls /api/... on its own
# origin and the Vite dev server proxies that to VITE_API_PROXY. Set it only
# when the API is on a different origin than the site (then add that origin to
# CORS_ORIGINS in backend/.env).
VITE_API_PROXY=http://127.0.0.1:8000
# VITE_API_URL=https://api.example.com

# Points the ask bar at a real retrieval backend. Unset, it answers from the
# written answers loaded with the rest of the content.
# VITE_ASK_API=http://127.0.0.1:8000/api/ask
